{
  "name": "react-infinity-sidebar",
  "private": false,
  "version": "1.0.10",
  "description": "A fully customizable and responsive sidebar component for React applications, built with TailwindCSS and Headless UI. Easily integrate dynamic navigation menus, dark mode, and various styling options. Designed for dashboards, admin panels, and modern web applications, this component provides a smooth user experience with minimal setup. Supports multiple layouts, collapsible sections, and seamless animations. Works out-of-the-box with TailwindCSS configurations and allows deep customization to match your project’s branding. Enhance your React app’s navigation experience with a professional sidebar solution.",
  "main": "dist/my-react-sidebar-tailwind-package.umd.js",
  "module": "dist/my-react-sidebar-tailwind-package.es.js",
  "types": "dist/index.d.ts",
  "style": "dist/sidebar.css",
  "type": "module",
