    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:css": "npx tailwindcss -i ./src/index.css -o ./dist/sidebar.css --minify",
    "lint": "eslint .",
    "preview": "vite preview"
